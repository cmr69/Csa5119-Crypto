
#include <stdio.h>
#include <math.h>

int main() {
    double keys, uniqueKeys;

    // Total possible arrangements of 25 letters
    keys = 1;

    for (int i = 1; i <= 25; i++) {
        keys = keys * i;
    }

    // Approximate power of 2
    printf("Total possible keys = %.0f\n", keys);
    printf("Approximate power of 2 = 2^%.2f\n",
           log(keys) / log(2));

    // Equivalent keys due to matrix transformations
    uniqueKeys = keys / 8;

    printf("Effectively unique keys = %.0f\n", uniqueKeys);
    printf("Unique keys approximately = 2^%.2f\n",
           log(uniqueKeys) / log(2));

    return 0;
}

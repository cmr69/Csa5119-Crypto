
#include <stdio.h>
#include <string.h>

int main() {
    char key[] = "ROYALNEWZEALANDNAVY";
    char cipher[] =
    "KXJEYUREBEZWEHEWRYTUHEYFS"
    "KREHEGOYFIWTTTUOLKSYCAJPO"
    "BOTEIZONTXBYBNTGONEYCUZWR"
    "GDSONSXBOUYWRHEBAAHYUSEDQ";

    char matrix[5][5];
    int used[26] = {0};
    int i, j, k = 0;

    // Create Playfair matrix
    for (i = 0; key[i] != '\0'; i++) {
        char ch = key[i];
        if (ch == 'J') ch = 'I';

        if (!used[ch - 'A']) {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }

    for (i = 0; i < 26; i++) {
        if (i == 9) continue;

        if (!used[i]) {
            matrix[k / 5][k % 5] = 'A' + i;
            k++;
        }
    }

    printf("Playfair Matrix:\n");

    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++)
            printf("%c ", matrix[i][j]);
        printf("\n");
    }

    printf("\nDecrypted message:\n");

    // Decrypt ciphertext in pairs
    for (i = 0; cipher[i] != '\0'; i += 2) {
        char a = cipher[i];
        char b = cipher[i + 1];
        int r1, c1, r2, c2;

        // Special case: TT was transmitted unchanged
        if (a == 'T' && b == 'T') {
            printf("TT");
            continue;
        }

        for (j = 0; j < 25; j++) {
            if (matrix[j / 5][j % 5] == a) {
                r1 = j / 5;
                c1 = j % 5;
            }

            if (matrix[j / 5][j % 5] == b) {
                r2 = j / 5;
                c2 = j % 5;
            }
        }

        if (r1 == r2) {
            printf("%c%c",
                matrix[r1][(c1 + 4) % 5],
                matrix[r2][(c2 + 4) % 5]);
        }
        else if (c1 == c2) {
            printf("%c%c",
                matrix[(r1 + 4) % 5][c1],
                matrix[(r2 + 4) % 5][c2]);
        }
        else {
            printf("%c%c",
                matrix[r1][c2],
                matrix[r2][c1]);
        }
    }

    return 0;
}

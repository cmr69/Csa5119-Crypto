
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char text[100];
    char key[] = "CIPHER";
    char cipher[27];
    int used[26] = {0};
    int i, j = 0;

    // Generate cipher alphabet using keyword
    for (i = 0; key[i] != '\0'; i++) {
        char ch = toupper(key[i]);

        if (!used[ch - 'A']) {
            cipher[j++] = ch;
            used[ch - 'A'] = 1;
        }
    }

    // Add remaining alphabet letters
    for (i = 0; i < 26; i++) {
        if (!used[i]) {
            cipher[j++] = 'A' + i;
        }
    }

    cipher[26] = '\0';

    printf("Plain alphabet : ABCDEFGHIJKLMNOPQRSTUVWXYZ\n");
    printf("Cipher alphabet: %s\n", cipher);

    printf("\nEnter plaintext: ");
    fgets(text, sizeof(text), stdin);

    // Encrypt plaintext
    printf("Encrypted text: ");

    for (i = 0; text[i] != '\0'; i++) {
        if (isupper(text[i])) {
            printf("%c", cipher[text[i] - 'A']);
        }
        else if (islower(text[i])) {
            printf("%c", tolower(cipher[text[i] - 'a']));
        }
        else {
            printf("%c", text[i]);
        }
    }

    return 0;
}


#include <stdio.h>
#include <string.h>
#include <ctype.h>

int gcd(int a, int b) {
    while (b != 0) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int main() {
    char cipher[500];
    int a, b, i;

    printf("Enter ciphertext: ");
    fgets(cipher, sizeof(cipher), stdin);

    printf("\nPossible decrypted messages:\n");

    for (a = 1; a < 26; a++) {
        if (gcd(a, 26) == 1) {

            int inv = 0;

            for (i = 1; i < 26; i++) {
                if ((a * i) % 26 == 1) {
                    inv = i;
                    break;
                }
            }

            // B = 1 maps from E = 4
            // U = 20 maps from T = 19
            b = (1 - a * 4) % 26;
            b = (b + 26) % 26;

            if ((a * 19 + b) % 26 == 20) {

                printf("\nKey a = %d, b = %d\n", a, b);
                printf("Plaintext: ");

                for (i = 0; cipher[i] != '\0'; i++) {
                    if (isupper(cipher[i])) {
                        printf("%c",
                        ((inv * (cipher[i] - 'A' - b + 26)) % 26) + 'A');
                    }
                    else if (islower(cipher[i])) {
                        printf("%c",
                        ((inv * (cipher[i] - 'a' - b + 26)) % 26) + 'a');
                    }
                    else {
                        printf("%c", cipher[i]);
                    }
                }
            }
        }
    }

    return 0;
}

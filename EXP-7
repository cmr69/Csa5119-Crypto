
#include <stdio.h>
#include <string.h>

int main() {
    char cipher[1000];
    int freq[256] = {0};
    int i;

    printf("Enter ciphertext:\n");
    fgets(cipher, sizeof(cipher), stdin);

    for (i = 0; cipher[i] != '\0'; i++) {
        unsigned char ch = cipher[i];

        if (ch != ' ' && ch != '\n') {
            freq[ch]++;
        }
    }

    printf("\nSymbol Frequency:\n");

    for (i = 0; i < 256; i++) {
        if (freq[i] > 0) {
            printf("%c = %d\n", i, freq[i]);
        }
    }

    return 0;
}

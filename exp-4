
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char text[100], key[100];
    int i, j = 0;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter key: ");
    scanf("%s", key);

    int len = strlen(key);

    printf("Encrypted text: ");

    for (i = 0; text[i] != '\0'; i++) {

        if (isalpha(text[i])) {

            char base = isupper(text[i]) ? 'A' : 'a';

            int shift = toupper(key[j % len]) - 'A';

            char encrypted = (text[i] - base + shift) % 26 + base;

            printf("%c", encrypted);

            j++;
        }
        else {
            printf("%c", text[i]);
        }
    }

    return 0;
}

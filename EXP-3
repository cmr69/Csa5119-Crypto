
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char key[30], text[100], matrix[5][5];
    int used[26] = {0};
    int i, j, k = 0;

    printf("Enter keyword: ");
    scanf("%s", key);

    printf("Enter plaintext: ");
    scanf("%s", text);

    // Create 5x5 matrix
    for (i = 0; key[i] != '\0'; i++) {
        char ch = toupper(key[i]);
        if (ch == 'J') ch = 'I';

        if (ch >= 'A' && ch <= 'Z' && !used[ch - 'A']) {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }

    for (i = 0; i < 26; i++) {
        if (i == 9) continue;

        if (!used[i]) {
            matrix[k / 5][k % 5] = 'A' + i;
            k++;
        }
    }

    printf("\nPlayfair Matrix:\n");
    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++)
            printf("%c ", matrix[i][j]);
        printf("\n");
    }

    // Encrypt plaintext
    for (i = 0; text[i] != '\0'; i++)
        text[i] = toupper(text[i]);

    for (i = 0; text[i] != '\0'; i++) {
        if (text[i] == 'J') text[i] = 'I';
    }

    printf("\nEncrypted text: ");

    for (i = 0; text[i] != '\0'; i += 2) {
        char a = text[i];
        char b = text[i + 1];

        if (b == '\0') b = 'X';

        if (a == b) {
            b = 'X';
            i--;
        }

        int r1, c1, r2, c2;

        for (j = 0; j < 25; j++) {
            if (matrix[j / 5][j % 5] == a) {
                r1 = j / 5;
                c1 = j % 5;
            }
            if (matrix[j / 5][j % 5] == b) {
                r2 = j / 5;
                c2 = j % 5;
            }
        }

        if (r1 == r2) {
            printf("%c%c",
                matrix[r1][(c1 + 1) % 5],
                matrix[r2][(c2 + 1) % 5]);
        }
        else if (c1 == c2) {
            printf("%c%c",
                matrix[(r1 + 1) % 5][c1],
                matrix[(r2 + 1) % 5][c2]);
        }
        else {
            printf("%c%c",
                matrix[r1][c2],
                matrix[r2][c1]);
        }
    }

    return 0;
}
